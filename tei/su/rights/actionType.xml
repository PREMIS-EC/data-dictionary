<?xml version="1.0" encoding="UTF-8"?>
<div type="elementDocumentation" xmlns="http://www.tei-c.org/ns/1.0"
    xml:id="actionType">
    <head>
        <!-- PREMIS Semantic unit 4.2.3.2.1 -->
        <abbr>4.2.3.2.1</abbr>
        <gi>actionType</gi>
    </head>
    <div type="semanticcomponents">
        <!-- PREMIS Semantic components -->
        <p>None</p>
    </div>
    <div type="definition">
        <!-- PREMIS Definition -->
        <p>The action the preservation repository is allowed/prohibited/obliged to take.</p>
    </div>

<!-- <div type="rationale"> -->
        <!-- PREMIS Rationale -->
    <!-- </div> -->

    <div type="datatype">
        <!-- PREMIS Data constraint -->
        <p>Value should be taken from a controlled vocabulary. A controlled vocabulary is available at: http://id.loc.gov/vocabulary/preservation/actionsGranted.html</p>
<!-- Linked Vocabulary element name and URI must be updated  -->
 </div>
    <div type="examples">
        <!-- PREMIS Examples -->
        <p>
		    <list type="simple">
                <item>Replicate</item>
                <item>Modify</item>
				<item>Use</item>
                <item>Disseminate</item>
            </list>
		</p>
    </div>
    <div type="entity">
        <p>
            <list type="simple">
                <label>Obligation</label>
                <item>Mandatory</item>
                <label>Repeatability</label>
                <item>Not repeatable</item>
            </list>
        </p>
    </div>

    <!-- <div type="creationmaintenance"> -->
        <!-- PREMIS Creation / Maintenance -->
    <!-- </div> -->

    <div type="usagenotes">
        <!-- PREMIS Usage notes -->
        <p> It is up to the preservation repository to decide how granular the controlled vocabulary should be. It may be useful to employ the same controlled values that the repository uses for <bold>eventType</bold>.</p>
    </div>
</div>

