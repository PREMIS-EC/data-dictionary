    <div type="entity">
        <p>
            <list type="simple">
                <label>Obligation</label>
                <item>Optional</item>
                <label>Repeatability</label>
                <item>Not repeatable</item>
            </list>
        </p>
    </div>

    <!-- <div type="creationmaintenance"> -->
