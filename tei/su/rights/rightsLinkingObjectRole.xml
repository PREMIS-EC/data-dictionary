<?xml version="1.0" encoding="UTF-8"?>
<div type="elementDocumentation" xmlns="http://www.tei-c.org/ns/1.0"
    xml:id="rightsLinkingObjectRole">
    <head>
        <!-- PREMIS Semantic unit 4.2.4.3 -->
        <abbr>4.2.4.3</abbr>
        <gi>linkingObjectRole</gi>
    </head>
    <div type="semanticcomponents">
        <!-- PREMIS Semantic components -->
        <p>None</p>
    </div>
    <div type="definition">
        <!-- PREMIS Definition -->
        <p>The role of the Object associated with a Right.</p>
    </div>
    <div type="rationale">
        <!-- PREMIS Rationale -->
        <p>Distinguishes the role of the object in relation to a Right. If this is not a direct or explicit relationship, it is necessary to analyze the relationship in the object metadata.</p>
    </div>
    <div type="datatype">
        <!-- PREMIS Data constraint -->
        <p>None</p>
    </div>
<!--     <div type="examples"> -->
        <!-- PREMIS Examples -->
    <!-- </div> -->
	
    <div type="entity">
        <p>
            <list type="simple">
                <label>Obligation</label>
                <item>Optional</item>
                <label>Repeatability</label>
                <item>Not repeatable</item>
            </list>
        </p>
    </div>

    <!-- <div type="creationmaintenance"> -->
        <!-- PREMIS Creation / Maintenance -->
    <!-- </div> -->

    <div type="usagenotes">
        <!-- PREMIS Usage notes -->
        <p>This value need not be supplied in the ordinary case where the role of the linked-to object is to be governed by the Rights statement. If the object has a different relationship to the Rights statement, however, it should be noted here.</p>
    </div>

</div>