<?xml version="1.0" encoding="UTF-8"?>
<div type="elementDocumentation" xmlns="http://www.tei-c.org/ns/1.0"
    xml:id="rightsStatement">
    <head>
        <!-- PREMIS Semantic unit 4.2.0 -->
        <abbr>4.2</abbr>
        <gi>rightsStatement</gi>
    </head>
    <div type="semanticcomponents">
        <!-- PREMIS Semantic components -->
        <p>4.2.1 rightsBasis</p>
        <p>4.2.2 rightsInformation</p>
        <p>4.2.3 rule</p>
        <p>4.2.4 linkingObjectIdentifier</p>
</div>
    <div type="definition">
        <!-- PREMIS Definition -->
        <p>Documentation of the repository's Rights--duty, obligation, or restrictions--to perform one or more actions.</p>
    </div>

<!-- <div type="rationale"> -->
        <!-- PREMIS Rationale -->
    <!-- </div> -->

    <div type="datatype">
        <!-- PREMIS Data constraint -->
        <p>Container</p>
    </div>

<!--     <div type="examples"> -->
        <!-- PREMIS Examples -->
    <!-- </div> -->

    <div type="entity">
        <p>
            <list type="simple">
                <label>Obligation</label>
                <item>Optional</item>
                <label>Repeatability</label>
                <item>Repeatable</item>
            </list>
        </p>
    </div>

    <!-- <div type="creationmaintenance"> -->
        <!-- PREMIS Creation / Maintenance -->
    <!-- </div> -->

    <div type="usagenotes">
        <!-- PREMIS Usage notes -->
        <p>This semantic unit is optional because in some cases Rights may be unknown. Institutions are encouraged to record Rights information when possible. Either <italic>rightsStatement</italic> or <italic>rightsExtension</italic> must be present if the Rights entity is included. The <italic>rightsStatement</italic> should be repeated when the act(s) described has (have) more than one basis, or when different acts have different bases.</p>
    </div>
</div>

